{
  "name": "spokio-studio-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Spokio Studio promo video (16:9, 1:1, 9:16, 40s) built with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts Promo out/spokio-studio-promo.mp4 --codec=h264 --crf=16",
    "build:square": "remotion render src/index.ts PromoSquare out/spokio-studio-promo-1x1.mp4 --codec=h264 --crf=16",
    "build:vertical": "remotion render src/index.ts PromoVertical out/spokio-studio-promo-9x16.mp4 --codec=h264 --crf=16",
    "build:all": "npm run build && npm run build:square && npm run build:vertical",
    "build:loop": "remotion render src/index.ts Promo out/spokio-studio-promo.webm --codec=vp9 --muted",
    "build:loop:square": "remotion render src/index.ts PromoSquare out/spokio-studio-promo-1x1.webm --codec=vp9 --muted",
    "build:loop:vertical": "remotion render src/index.ts PromoVertical out/spokio-studio-promo-9x16.webm --codec=vp9 --muted",
    "poster": "remotion still src/index.ts Promo out/poster.png --frame=300",
    "poster:square": "remotion still src/index.ts PromoSquare out/poster-1x1.png --frame=300",
    "poster:vertical": "remotion still src/index.ts PromoVertical out/poster-9x16.png --frame=300",
    "poster:all": "npm run poster && npm run poster:square && npm run poster:vertical",
    "audio": "python3 scripts/make_audio.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
